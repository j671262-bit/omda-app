# Copiez ce fichier en `.env` (ignoré par git) et complétez les valeurs.
# Après toute modification : redémarrez Metro avec `npx expo start -c`.
# ATTENTION : tout ce qui commence par EXPO_PUBLIC_ est lisible dans l'application publiée.
# N'y mettez JAMAIS la clé `service_role`, un secret MVola ou le TRACKING_CODE_PEPPER.

# --- Application mobile -------------------------------------------------------
# URL du projet Supabase et clé PUBLIQUE « anon » (Project Settings > API).
EXPO_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon

# URL de l'API candidat (serveur Express du dossier `server/`), SANS barre finale
# et sans `/v1` (ajouté par l'application). Sur un téléphone réel, `localhost` ne
# fonctionne pas : utilisez l'adresse IP de votre ordinateur (ex. http://192.168.1.20:8080)
# ou un tunnel HTTPS.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:8080

# --- Serveur `server/` : variables à définir dans l'environnement du serveur ---
# (le serveur ne lit PAS ce fichier .env : exportez-les ou utilisez `node --env-file=.env`)
# SUPABASE_URL=https://votre-projet.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=      # secret serveur uniquement
# TRACKING_CODE_PEPPER=           # aléatoire, 32 caractères minimum : `openssl rand -hex 32`
# HOST=0.0.0.0                    # 127.0.0.1 par défaut ; 0.0.0.0 pour qu'un téléphone puisse joindre le serveur
# PORT=8080
# CORS_ALLOWED_ORIGINS=           # origines web autorisées, séparées par des virgules
# TRUST_PROXY_HOPS=0              # nombre de reverse proxies de confiance devant le serveur (0 à 5)
# NODE_ENV=production
# Limites de débit (valeurs par défaut entre parenthèses). Augmentez-les le temps des tests :
# LIMITE_CREATIONS_PAR_HEURE=500       # dossiers créés par adresse IP (10)
# LIMITE_TELEVERSEMENTS_PAR_HEURE=500  # fichiers déposés par adresse IP (30)
# LIMITE_REQUETES_PAR_10_MIN=1000      # requêtes protégées par code de suivi, par IP (120)
# LIMITE_ECHECS_CODE_PAR_HEURE=50      # codes de suivi erronés avant verrouillage d'un dossier (10)
#
# Démarrage avec ce fichier : cd server && npm run dev   (Node 20.6 ou plus)
